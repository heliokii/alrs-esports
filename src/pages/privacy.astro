---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const sections = [
  { title: 'Who we are', body: [`${site.name} ("we") is an esports team based in ${site.city}, ${site.country}. We decide how the personal data sent through this site is used.`] },
  { title: 'What we collect', body: ['Only what you type into our forms. This site sets no cookies and runs no analytics or advertising trackers.'], list: [
    'Tryout form: in-game name, Riot ID, email, Discord username, ranks, role, agents, availability and your note',
    'Partnership form: name, brand, email and message',
    'Contact form: name, email and message',
  ] },
  { title: 'Why we use it', body: ['To review tryout applications, answer partnership enquiries and reply to messages. We do not sell your data or use it for advertising.'] },
  { title: 'Consent', body: ['We process your details on the basis of the consent you give by ticking the box on each form. You can withdraw it at any time by emailing us, and we will delete your details.'] },
  { title: 'Under 18', body: ['If you are under 18, ask a parent or guardian before sending a form. We may ask for their consent before inviting you to trial scrims.'] },
  { title: 'Who sees it', body: ['Team staff who handle tryouts, partnerships and messages. Form submissions travel through our email or form provider to reach us.'] },
  { title: 'How long we keep it', body: ['Tryout applications are kept for up to 12 months. Other messages are kept for as long as the conversation needs.'] },
  { title: 'Your rights', body: ['Under the Philippine Data Privacy Act of 2012 you can ask to see, correct or delete the personal data we hold about you. You can also raise a concern with the National Privacy Commission.'] },
  { title: 'Contact', body: [`Email ${site.email} for any privacy request.`] },
];
---
<Base title={`Privacy policy | ${site.name}`} description={`How ${site.name} collects and uses personal data.`}>
  <section class="band page-head">
    <div class="wrap">
      <span class="label">Effective 10 November 2026</span>
      <h1 class="h-page" style="font-size:clamp(48px,8vw,112px)">Privacy policy</h1>
      <p class="lede">How {site.name} collects, uses and protects your personal data</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap" style="padding-block:0 clamp(56px,8vw,96px)">
      {sections.map((s, i) => (
        <article class="post">
          <div>
            <span class="label num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="h-item">{s.title}</h2>
          </div>
          <div class="prose">
            {s.body.map((p) => <p>{p}</p>)}
            {s.list && <ul>{s.list.map((l) => <li>{l}</li>)}</ul>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

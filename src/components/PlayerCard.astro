---
interface Props { n: string; name: string; role?: string; tag: string; riotId?: string; agents?: string[]; photo?: string }
const { n, name, role, tag, riotId, agents = [], photo } = Astro.props;
---
<article class:list={['pcard', { 'pcard--photo': photo }]} data-tilt tabindex="0" aria-label={role ? `${name}, ${role}` : name}>
  <i class="tick tick--tl" aria-hidden="true"></i>
  <i class="tick tick--br" aria-hidden="true"></i>
  <div class="ghost-num num" aria-hidden="true">{n}</div>
  {photo && <img class="pcard__photo" src={photo} alt="" loading="lazy" decoding="async">}
  <div class="pcard__top">
    <span class="label num">{n}</span>
    <span class="tag">{tag}</span>
  </div>
  <div class="pcard__body">
    {agents.length > 0 && (
      <ul class="agents" aria-label="Agent pool">{agents.map((a) => <li>{a}</li>)}</ul>
    )}
    <h3>{name}</h3>
    {riotId && <span class="label">{riotId}</span>}
    {role && <div class="kv"><span>Role</span><span>{role}</span></div>}
  </div>
</article>
